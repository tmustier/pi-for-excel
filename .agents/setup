#!/usr/bin/env bash
# Prepare an Amp orb: install npm dependencies so the dev server, checks,
# tests, and build run. The dev server itself is declared in .amp/services.yaml.
set -euo pipefail

cd "$(dirname "$0")/.."

step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "==> $label"
  "$@"
  echo "<== $label ($((SECONDS - start))s)"
}

# npm ci always wipes and reinstalls node_modules (~20s); skip it when a
# restored snapshot was installed from the same lockfile and Node version.
stamp=node_modules/.orb-setup-stamp
want="$(node --version) $(sha256sum package-lock.json | cut -d' ' -f1)"
if [[ -f $stamp && "$(cat "$stamp")" == "$want" ]]; then
  echo "==> node_modules matches package-lock.json; skipping npm ci"
else
  step "npm ci" npm ci --no-audit --no-fund
  echo "$want" > "$stamp"
fi

# Browser tests (npm run test:browser) use Playwright's Chromium.
step "playwright chromium" npx --no-install playwright install chromium
